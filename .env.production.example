APP_NAME="Lin Htut Restaurant Ledger"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com/your-folder/
APP_TIMEZONE=Asia/Bangkok

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hostinger_prefixed_db_name
DB_USERNAME=hostinger_prefixed_db_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_COOKIE=lin-htut-restaurant-session
SESSION_PATH=/your-folder/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
