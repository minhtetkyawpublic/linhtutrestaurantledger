{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "lint": "eslint resources/js resources/pwa scripts vite.config.js vitest.config.js",
        "format:check": "prettier --check resources/js resources/css resources/pwa scripts public/offline.html public/manifest.webmanifest package.json vite.config.js vitest.config.js",
        "test:ui": "vitest run",
        "test:browser": "node scripts/test-browser.mjs",
        "test:browser:dev": "node scripts/test-vite-browser.mjs",
        "pwa:icons": "node scripts/build-pwa-icons.mjs",
        "build": "npm run pwa:icons && vite build && node scripts/build-service-worker.mjs",
        "translations:check": "node scripts/check-translations.mjs",
        "runtime:paths:test": "node scripts/test-runtime-paths.mjs",
        "hostinger:verify": "node scripts/verify-hosting-readiness.mjs",
        "build:verify": "npm run lint && npm run format:check && npm run test:ui && npm run translations:check && npm run runtime:paths:test && npm run build && npm run hostinger:verify"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@vitejs/plugin-react": "^4.5.2",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "globals": "^16.4.0",
        "jsdom": "^26.1.0",
        "laravel-vite-plugin": "^2.0.0",
        "playwright-core": "^1.62.1",
        "prettier": "^3.9.6",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "sharp": "^0.35.3",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7",
        "vitest": "^3.2.6"
    }
}
