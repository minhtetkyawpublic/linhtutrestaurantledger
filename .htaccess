<IfModule mod_negotiation.c>
    Options -Indexes -MultiViews
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Protect source files and common sensitive paths when document root is the repo root.
    RewriteRule ^\.well-known(/|$) - [L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule (^|/)composer\.(json|lock)$ - [F,L]
    RewriteRule (^|/)package(-lock)?\.json$ - [F,L]
    RewriteRule (^|/)phpunit(\.[A-Za-z0-9_-]+)?\.xml(\.dist)?$ - [F,L]
    RewriteRule (^|/)(vite|vitest|eslint|postcss|tailwind)\.config\.(js|ts|mjs|cjs)$ - [F,L]
    RewriteRule ^(app|bootstrap|config|database|node_modules|reference_docs|resources|routes|scripts|storage|tests|vendor)/ - [F,L]
    RewriteRule ^\.env - [F,L]
    RewriteRule ^\.git - [F,L]
    RewriteRule ^artisan$ - [F,L]
    RewriteRule ^(README|DEPLOYMENT_RECORD|LOCAL_TEST_COMMANDS)(\.[A-Za-z0-9_-]+)?$ - [F,L]

    # Map only reviewed public assets. The relative substitution preserves any
    # folder prefix automatically when this project is nested in public_html.
    RewriteRule ^(build/.*|favicon\.ico|icons?/.*|icon-(192|512)\.(svg|png)|manifest\.webmanifest|offline\.html|robots\.txt|service-worker\.js)$ public/$1 [L,NS,QSA]

    # Route everything else through Laravel's front controller.
    RewriteRule ^ index.php [L,QSA]
</IfModule>
